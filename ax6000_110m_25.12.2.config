# ============================================================
# 红米 AX6000 · 110M 大分区 · ImmortalWrt v25.12.2
#
# 路线 C：内核配置层与官方 buildbot 逐行一致 ⇒ 期望内核 ABI 哈希
#         b5b7729ffbba3ecdd83f339de8fadfb8
#   ⇒ releases/25.12.2/targets/mediatek/filogic/kmods/6.12.103-1-b5b7729ffbba3ecdd83f339de8fadfb8/
#     里那 1120 个官方 kmod 包可以直接 apk 安装（不用再自己编 kmods）。
#     ⚠ 25.12 起包管理器从 opkg(ipk) 换成 apk(*)：手动装 kmod 用
#       `apk add --allow-untrusted <file>.apk`，旧 ipk 不能混装。
#
# 本文件不是手写的，是派生的。生成方式（可用同目录 gen-config-25.12.2.py 重跑）：
#   源   = releases/25.12.2/targets/mediatek/filogic/config.buildinfo（443 行）
#   第 1 节 = 源文件第 1-3 行，一字不改
#   第 2 节 = 删掉源文件里 374 行设备定义（187 台），
#             换成只勾选本机这一台；并把 TARGET_ALL_PROFILES 关掉
#   第 3 节 = 其余官方行，一字不改（ALL_PROFILES 那行挪到第 2 节）
#   第 4 节 = 本机增量包（该节说明了为什么它们不影响内核 ABI 哈希）
#
# ⚠⚠ 不要在这里添加或修改任何 CONFIG_KERNEL_* 行 ⚠⚠
#   内核 ABI 哈希 = md5(排序后内核 .config 里所有 =y/=m 行)，它的输入只有两个：
#     ① 本节所有 CONFIG_KERNEL_* 行
#     ② 所有被选中包的 Kernel-Config（由 ALL_KMODS 决定规模）
#   手写 CONFIG_KERNEL_* 正是上一版固件 panic 的根因：
#   手写 fragment 等于关掉 ALL_KMODS ⇒ 数百个内核符号从 m 变 n ⇒ 哈希跑到
#   ddbfaf81… 那一支 ⇒ 官方 .ko 是给另一份内核配置编的，insmod 直接炸。
# ============================================================

# ---------- 1. 目标平台（官方一字不改）----------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y

# ---------- 2. 设备：只编这一台 ----------
# 官方 config 里 BUILDBOT=y ⇒ TARGET_ALL_PROFILES 默认为 y ⇒ 上百台设备
# 全部默认选中。这里关掉它，再显式勾选 110M 这一台：
#   · 设备符号的真实名字随 TARGET_MULTI_PROFILE 走（include/image.mk:558）：
#     MULTI_PROFILE=y 时是 CONFIG_TARGET_DEVICE_<conf>_DEVICE_<dev>，
#     下面这行就是官方那种写法，不是老式的 CONFIG_TARGET_<conf>_DEVICE_<dev>。
#   · 编译量只由"选中几台设备"决定，MULTI_PROFILE 本身不控制编译量。
#   · 本机设备定义由 110m-patch.sh / workflow 的补丁步骤在 filogic.mk 里追加
#     （Device/xiaomi_redmi-router-ax6000-110m），设备名 = 补丁里那行。
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-110m=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-110m=""

# ---------- 3. 官方构建开关（源文件其余 65 行，一字不改）----------

CONFIG_ALL_KMODS=y
CONFIG_ALL_NONSHARED=y
CONFIG_DEVEL=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_AUTOREMOVE=y
CONFIG_BUILDBOT=y
CONFIG_BUILD_LOG=y
CONFIG_COLLECT_KERNEL_DEBUG=y
CONFIG_DWARVES=y
CONFIG_IB=y
CONFIG_IMAGEOPT=y
CONFIG_JSON_CYCLONEDX_SBOM=y
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_ARM_PMUV3=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_BUILD_DOMAIN="buildbot.infra.immortalwrt.org"
CONFIG_KERNEL_BUILD_USER="buildbot"
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_KERNEL_NETKIT=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_MAKE_TOOLCHAIN=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=m
CONFIG_PACKAGE_kselftests-bpf=m
CONFIG_PACKAGE_libbfd=m
CONFIG_PACKAGE_libbz2=m
CONFIG_PACKAGE_libctf=m
CONFIG_PACKAGE_libdw=m
CONFIG_PACKAGE_libopcodes=m
CONFIG_PACKAGE_libpcap=m
CONFIG_PACKAGE_libtraceevent=m
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
CONFIG_PACKAGE_musl-fts=m
CONFIG_PACKAGE_objdump=m
CONFIG_PACKAGE_owut=y
CONFIG_PACKAGE_perf=m
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_ucode-mod-uclient=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
CONFIG_SDK=y
CONFIG_SDK_LLVM_BPF=y
CONFIG_TARGET_ROOTFS_PARTSIZE=300
CONFIG_VERSIONOPT=y
CONFIG_VERSION_BUG_URL=""
CONFIG_VERSION_CODE=""
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_FIRMWARE_URL=""
CONFIG_VERSION_HOME_URL=""
CONFIG_VERSION_HWREV=""
CONFIG_VERSION_MANUFACTURER=""
CONFIG_VERSION_MANUFACTURER_URL=""
CONFIG_VERSION_NUMBER=""
CONFIG_VERSION_PRODUCT=""
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/25.12.2"
CONFIG_VERSION_SUPPORT_URL=""

# ---------- 4. 本机增量包（可选层；已证明不进内核 ABI 哈希）----------
# 为什么增删这些包不会改变内核 ABI（源码级，scripts/package-metadata.pl）：
#   gen_kconfig_overrides() 里，
#     :75  my $val = 'm';                      ← 写进内核配置的值恒为 m
#     :82  if ($config{"CONFIG_PACKAGE_$package"})  ← 只看"出现过没有"
#   ⇒ 一个包只要在 .config 里出现过（=y 还是 =m 都一样），它的 Kernel-Config
#     就以 =m 写进内核配置；把某个 kmod 从 m 改成 y 只影响"装不装进固件"。
#   ⇒ 而 CONFIG_ALL_KMODS=y 已经让下面每个 kmod 都以 m 出现过，
#     所以这一节整体对内核 ABI 是零影响。
# 反过来才是致命的：**不能把包写成 `# CONFIG_PACKAGE_x is not set` 或直接删掉**，
#   那会让 :86 的 `$kconfig{$config} = 'n'` 生效，内核符号从 m 变 n，哈希立刻分家。
# 唯一例外在本节末尾：perf —— 它的 Makefile 里一个 Kernel-Config 都没有，
#   关掉它不会让任何内核符号变 n（理由与证据见那一段注释）。

CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nft-queue=y

# CONFIG_PACKAGE_perf is not set
#   24.10.6 那次云编译 2h59m 的失败点就是它（内核 6.6.133 的坏回溯补丁：
#   tools/perf/util/unwind-libdw.c 调用 map_symbol__exit()，而该版本里根本没有
#   tools/perf/util/map_symbol.c，util/Build 里也没有 map_symbol.o）。
#   现在内核换到 6.12.103，那个坏回溯补丁多半已经不在了 —— 但我们本来就不需要 perf，
#   关掉可以少编 perf/libdw/libbfd/libopcodes/libctf/objdump 一串 staging 包。
#   perf 是 m 包、不进固件；package/devel/perf/Makefile 通篇没有一个 Kernel-Config
#   ⇒ 关掉它对内核 ABI 哈希零影响。这是本文件唯一一处 is not set，
#   万一连带了别的依赖、真的动了哈希，ABI 门会在工具链之后拦下。

# ---------- 5. 刻意不设（沿用官方 / 上一版的经验）----------
# 不要设 CONFIG_OPTIMIZE_FOR_SIZE / CONFIG_STRIP_KERNEL_EXPORTS：
#   前者收益极小；后者会把内核导出符号裁掉，以后编外部模块必失败。
#   （上游 lixiang2017 的 compact config 里有这两条，别带回来。）
# 不要设语言白名单去"省空间"：官方本来就只装 zh-cn 的几个包，
#   英文是内建的，写 `# CONFIG_LUCI_LANG_xx is not set` 是 no-op，省 0 KB。
# 官方已把 kmod-xdp-sockets-diag 设为 m（编出来但不装进固件）；要装的话
#   apk 装官方池里的同名包即可（ABI 一致）。同理：上面第 4 节没列的 kmod，
#   1120 个官方包全都能直接装，这是这轮固件最大的收益。
#
# ---------- 6. 可选：按需打开（现在是注释，不影响编译）----------
# CONFIG_PACKAGE_luci-app-arpbind=y        # IP/MAC 绑定
# CONFIG_PACKAGE_luci-app-wol=y            # 网络唤醒
# CONFIG_PACKAGE_luci-app-upnp=y           # UPnP（游戏机/NAT 穿透）
# CONFIG_PACKAGE_luci-app-ddns=y           # 动态域名
# CONFIG_PACKAGE_luci-app-autoreboot=y     # 定时重启
# CONFIG_TARGET_ROOTFS_INITRAMFS=y         # 额外产出一份 initramfs 救援镜像
