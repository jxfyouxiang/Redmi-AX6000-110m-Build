# ============================================================
# ImmortalWrt 24.10  ·  红米 AX6000  ·  110M 大分区
# 适用 uboot：hanwckf / yuzhii 系，布局选 immortalwrt-110m
#
# 策略：官方默认包选择 + Argon 主题 + 代理所需的「只能编译时决定」的内核层
# 说明：这是一份 fragment config。`make defconfig` 会自动补齐官方默认包，
#       所以这里不需要（也不应该）罗列几千行默认选项。
# 预期产物：约 16 MB factory.bin，刷入后 overlay 约 80 MB
# ============================================================

# ---------- 目标设备（110M 设备定义由 workflow 的补丁步骤生成）----------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-110m=y

# ---------- 主题 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- 代理：用户态依赖（本体后期用 opkg 安装）----------
# 保留这些是为了让 OpenClash / daed 本体能顺利 opkg 装上并跑起来
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_luci-compat=y

# ---------- 代理：内核模块 ----------
# 这些 kmod 与内核版本绑定，opkg 装不了（自编译固件没有配套 kmod 源），
# 必须在这一步编进固件。少一个，对应插件就永远跑不起来。
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-ingress=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# ---------- daed 需要的 BPF / BTF 内核选项 ----------
# 只用 OpenClash 的话，从 CONFIG_KERNEL_BPF 到 CONFIG_KERNEL_XDP_SOCKETS
# 这一整块可以全部删掉，能省 1~2 MB 并缩短编译时间
CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_NET_INGRESS=y
CONFIG_KERNEL_NET_EGRESS=y
CONFIG_KERNEL_NET_CLS_ACT=y
CONFIG_KERNEL_BPFSTREAM=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y

# ---------- 刻意不设的选项（保持官方默认，别再走 compact 那条路）----------
# 不要设 CONFIG_OPTIMIZE_FOR_SIZE / CONFIG_STRIP_KERNEL_EXPORTS：
#   前者收益极小，后者会让内核导出符号被裁剪，以后想编译外部模块会失败。
# 不要设语言白名单 / 关 USB / 关 cifs、nfs：
#   官方默认版本本来就只有 16 MB，砍这些换不到空间，纯属白丢功能。
#
# 关于语言（实测 ImmortalWrt 24.10.6 官方 manifest）：
#   官方默认镜像本来就只装 zh-cn 的 4 个包（base / firewall /
#   package-manager / attendedsysupgrade，共 210 KB），英文是内建的
#   （根本不存在 luci-i18n-*-en 这种包）。
#   所以写 `# CONFIG_LUCI_LANG_xx is not set` 是 no-op，省 0 KB。
#   反过来说，把语言全开一次要 +5.96 MB（仅这 4 个应用），
#   全部应用 × 全部语言的理论上限是 +41.8 MB。
#   → 这一项保持默认即可，别动。

# ---------- 可选：按需打开（现在是注释，不影响编译）----------
# CONFIG_PACKAGE_luci-app-arpbind=y        # IP/MAC 绑定
# CONFIG_PACKAGE_luci-app-wol=y            # 网络唤醒
# CONFIG_PACKAGE_luci-app-upnp=y           # UPnP（游戏机/NAT 穿透）
# CONFIG_PACKAGE_luci-app-ddns=y           # 动态域名
# CONFIG_PACKAGE_luci-app-autoreboot=y     # 定时重启
# CONFIG_TARGET_ROOTFS_INITRAMFS=y         # 额外产出一份 initramfs 救援镜像
