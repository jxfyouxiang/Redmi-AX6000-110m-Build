#
# 小米 AX3000T —— yuzhii/hanwckf MTK U-Boot "immortalwrt-112m" 大分区布局
# ImmortalWrt 官方源码 (immortalwrt/immortalwrt, 分支 openwrt-24.10)
# 开源 mt76 驱动
#
# 用法：作为 config 片段追加到源码根目录的 .config，再 make defconfig
#       cat ax3000t-mt76-112m.config >> .config && make defconfig
#
# 注意：这个布局在官方源码里不存在，必须先跑 customize_ax3000t_112m.sh
#       把机型定义加进 target/linux/mediatek/image/filogic.mk，否则
#       make defconfig 会把这个 DEVICE 选项静默丢掉。
#

# ===== 目标平台 =====
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-mtkuboot=y
CONFIG_TARGET_PROFILE="DEVICE_xiaomi_mi-router-ax3000t-mtkuboot"

# ===== 目标镜像 =====
# kernel 放 UBI 卷里（U-Boot 读名为 kernel 的卷，然后 bootm）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=160
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_TARGET_INITRAMFS_SEPARATE=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256

# ===== 开源 mt76 驱动（本方案的核心）=====
# 机型定义里已经写了 DEVICE_PACKAGES，这里显式再选一遍，方便 REVIEW 和断言。
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_iwinfo=y

# 明确排除 MTK 闭源驱动（官方树里本来就没有这些包，写成注释只是把意图记录在案）
# CONFIG_PACKAGE_kmod-mt_wifi is not set
# CONFIG_PACKAGE_mtwifi-cfg is not set
# CONFIG_PACKAGE_kmod-warp is not set
# CONFIG_PACKAGE_kmod-conninfra is not set

# ===== 界面：Argon =====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ===== 中文界面 =====
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ===== 常用小工具 =====
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_luci-app-commands=y

# 注意：以上 CONFIG_PACKAGE_xxx=y 若某个包在树里不存在，
#       make defconfig 会静默把它改成 "is not set"，不会报错中断。
#       编译流程里有一条断言会检查 kmod-mt7915e 是否真的被选中。
